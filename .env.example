# App URL used for canonical metadata and payment return URLs
APP_URL=http://localhost:3000

# Keep the app runnable without credentials
COMMERCE_PROVIDER=mock
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=

# TEST MODE ONLY. Never use live Stripe keys in this portfolio demo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: set PAYMENT_PROVIDER=stripe to enable hosted Stripe test checkout.
PAYMENT_PROVIDER=mock

# Mock ERP is the supported local mode for the initial phases
ERP_MODE=mock
# Local mock orders are saved here; keep the file out of version control
ORDER_STORE_PATH=.local/orders.json
# Future managed PostgreSQL connection; local mock mode does not use this yet
DATABASE_URL=
LOG_LEVEL=info
